<%# locals: (album:) %>

<img src="<%= Music.cover_url(album[:id]) %>" alt="" class="aspect-square w-full rounded-lg object-cover shadow saturate-[0.6] contrast-[1.1] transition group-hover:scale-[1.02] group-hover:saturate-100 group-hover:outline group-hover:outline-2 group-hover:outline-offset-2 group-hover:outline-lime-500">
<p class="mt-2 truncate text-sm font-semibold"><%= album[:title] %></p>
<p class="truncate text-xs text-gray-500"><%= album[:artist] %></p>
