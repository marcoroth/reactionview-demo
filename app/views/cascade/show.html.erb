<%# herb:slots client %>
<%# herb:state (continent: "", country: "", state: "") %>

<div class="mx-auto max-w-4xl px-4 py-6">
  <header class="mb-6 flex items-baseline justify-between">
    <h1 class="text-2xl font-bold">Where to?</h1>
  </header>

  <div class="flex flex-col gap-4 text-sm">
    <label class="flex flex-col gap-1">
      <span class="text-gray-500">Continent</span>
      <select value="<%= continent %>" data-herb-set="change->country='' change->state=''" class="rounded border border-gray-300 px-2 py-1">
        <option value="">Pick a continent</option>

        <% Geo.continents.each do |name| %>
          <option id="<%= name %>" value="<%= name %>"><%= name %></option>
        <% end %>
      </select>
    </label>

    <% if continent.present? %>
      <label class="flex flex-col gap-1">
        <span class="text-gray-500">Country</span>
        <select value="<%= country %>" data-herb-set="change->state=''" class="rounded border border-gray-300 px-2 py-1">
          <option value="">Pick a country</option>

          <% Geo.countries(continent).each do |name| %>
            <option id="<%= name %>" value="<%= name %>"><%= name %></option>
          <% end %>
        </select>
      </label>
    <% end %>

    <% if country.present? %>
      <label class="flex flex-col gap-1">
        <span class="text-gray-500">State</span>
        <select value="<%= state %>" class="rounded border border-gray-300 px-2 py-1">
          <option value="">Pick a state</option>

          <% Geo.states(continent, country).each do |name| %>
            <option id="<%= name %>"  value="<%= name %>"><%= name %></option>
          <% end %>
        </select>
      </label>
    <% end %>

    <% if state.present? %>
      <p id="cities" class="rounded border border-gray-200 bg-gray-50 p-3">
        You could live in
        <Fragment>
          <%= Geo.cities(continent, country, state).to_sentence(two_words_connector: " or ", last_word_connector: " or ") %>

          <Fallback>
            <div class="bg-gray-200 w-32 rounded animate-pulse inline-block">&nbsp;</div>
          </Fallback>
        </Fragment>
      </p>
    <% end %>
  </div>
</div>
