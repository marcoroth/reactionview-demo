<%# herb:slots client %>
<%# herb:state (modal: false, panel: false, alert: "") %>

<div class="mx-auto max-w-2xl px-4 py-6">
  <header class="mb-6 flex items-baseline justify-between">
    <h1 class="text-2xl font-bold">Overlays</h1>

  </header>

  <div class="flex flex-wrap gap-2 text-sm">
    <button type="button" data-herb-set="modal=true" class="rounded border px-3 py-1">Open dialog</button>
    <button type="button" data-herb-toggle="panel" class="rounded border px-3 py-1">Slide in panel</button>
    <button type="button" data-herb-set="alert='All systems are humming along'" class="rounded border px-3 py-1">Full-screen alert</button>
  </div>

  <% if modal %>
    <div class="fixed inset-0 z-40" data-herb-set="keydown.escape@window->modal=false">
      <div class="absolute inset-0 bg-gray-900/50 transition-opacity duration-200 starting:opacity-0" data-herb-set="modal=false"></div>

      <div class="absolute left-1/2 top-1/3 w-80 -translate-x-1/2 scale-100 rounded-lg bg-white p-6 shadow-xl transition-[opacity,scale] duration-200 starting:scale-95 starting:opacity-0">
        <h2 class="mb-2 text-lg font-bold">Delete everything?</h2>
        <p class="mb-4 text-sm text-gray-500"><%= Message.count %> messages would be gone forever.</p>

        <div class="flex justify-end gap-2 text-sm">
          <button type="button" data-herb-set="modal=false" class="rounded border px-3 py-1">Cancel</button>
          <button type="button" data-herb-set="modal=false alert='Nothing was deleted, you are safe'" class="rounded bg-red-600 px-3 py-1 text-white">Pretend</button>
        </div>
      </div>
    </div>
  <% end %>

  <aside data-open="<%= panel %>" data-herb-set="keydown.escape@window->panel=false" class="fixed inset-y-0 right-0 z-30 w-72 translate-x-full bg-white p-6 shadow-xl transition-transform duration-300 data-[open=true]:translate-x-0">
    <h2 class="mb-2 text-lg font-bold">Side panel</h2>
    <p class="mb-4 text-sm text-gray-500">This element never unmounts, so the slide out animates just like the slide in.</p>
    <button type="button" data-herb-set="panel=false" class="rounded border px-3 py-1 text-sm">Close</button>
  </aside>

  <% if alert.present? %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-emerald-600 text-white" data-herb-set="keydown.escape@window->alert=''">
      <div class="text-center">
        <p class="text-2xl"><%= alert %></p>
        <button type="button" data-herb-set="alert=''" class="mt-4 text-sm underline">Dismiss</button>
      </div>
    </div>
  <% end %>
</div>
