<%# herb:slots server %>
<%# herb:state (filter: "") %>

<div class="mx-auto max-w-4xl px-4 py-6">
  <header class="mb-6 flex items-center justify-between gap-3">
    <h1 class="text-2xl font-bold">Activity</h1>

    <button type="button" data-herb-action="$refresh" class="rounded border border-gray-300 bg-white px-3 py-1 text-sm hover:border-lime-500">Refresh</button>
  </header>

  <div class="mb-6 flex flex-wrap gap-2 text-sm">
    <% @kinds.each do |kind, label| %>
      <button herb-key="<%= label %>" type="button" data-herb-set="filter='<%= kind %>'" class="rounded-full border px-3 py-1 transition <%= filter == kind ? "border-lime-500 bg-lime-50 font-semibold text-lime-700" : "border-gray-300 bg-white text-gray-600 hover:border-lime-500" %>">
        <%= label %>
      </button>
    <% end %>
  </div>

  <ol class="relative ml-3 space-y-5 border-l border-gray-200 pl-6">
    <% @feed.each do |event| %>
      <li herb-key="<%= event[:id] %>" class="relative">
        <span class="absolute -left-9 flex h-6 w-6 items-center justify-center rounded-full bg-white text-sm ring-1 ring-gray-200"><%= event[:icon] %></span>
        <p class="text-sm text-gray-900"><%= event[:text] %></p>
        <p class="mt-0.5 text-xs text-gray-400"><%= event[:actor] %> &middot; <%= event[:at] %></p>
      </li>
    <% end %>
  </ol>

  <p class="mt-8 text-xs text-gray-400">
    Rendered by the server at <%= Time.current.strftime("%H:%M:%S") %>. Every filter and branch on this page is chosen server-side, the client only swaps values in.
  </p>
</div>
