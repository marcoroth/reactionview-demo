<%# herb:slots client %>
<%# herb:state (panel: false, height: "0.45", alert: "") %>

<div class="min-h-full bg-white">
  <div class="mx-auto max-w-4xl px-4 py-6">
    <header class="mb-6 flex items-baseline justify-between">
      <h1 class="text-2xl font-bold">Drawer</h1>
      <p class="hidden text-sm text-gray-500 sm:block">the sheet follows your finger, the state stays in the template</p>
    </header>

    <p class="mb-4 text-sm text-gray-500">
      Drag the sheet up to grow it through three heights, and down to shrink it. Past the smallest it dismisses, and a
      quick flick skips straight there. The template only ever sees <code class="rounded bg-gray-100 px-1">panel</code>
      and <code class="rounded bg-gray-100 px-1">height</code>, both plain state, so the number in the sheet header is
      rendered from the same value the drag writes.
    </p>

    <button type="button" data-herb-set="panel=true" class="rounded bg-lime-500 px-3 py-1 text-sm font-semibold text-white hover:bg-lime-600">
      Open the queue
    </button>

    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <% Music.albums.first(4).each do |album| %>
        <div herb-key="<%= album[:id] %>" class="group text-left">
          <%= render "shared/album_card", album: album %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div
  data-moly-drawer-overlay
  data-moly-drawer-open="<%= panel %>"
  data-herb-set="panel=false"
></div>

<aside
  data-moly-drawer="bottom"
  data-moly-drawer-state="panel"
  data-moly-drawer-snap="0.45, 0.68, 0.92"
  data-moly-drawer-snap-state="height"
  data-moly-drawer-open="<%= panel %>"
  style="--moly-drawer-size: 92svh"
>
  <div data-moly-drawer-handle></div>

  <header class="flex-none cursor-grab px-5 pb-3">
    <div class="flex items-baseline justify-between">
      <h2 class="text-lg font-bold">Up next</h2>

      <span class="ml-auto mr-2 text-xs tabular-nums text-gray-400"><%= height %></span>
      <button type="button" data-moly-drawer-no-drag data-herb-set="panel=false" class="rounded border border-gray-300 bg-white px-2 py-0.5 text-sm hover:border-lime-500">
        Close
      </button>
    </div>

    <p class="mt-1 text-xs text-gray-500">Scroll the list at any height, and drag the handle or this header to resize.</p>
  </header>

  <div class="overflow-y-auto overscroll-contain px-5 pb-8">
    <ul class="space-y-3 text-sm">
      <% Music.albums.first(6).each do |album| %>
        <% Music.tracks(album[:id]).each do |track| %>
          <li herb-key="<%= album[:id] %>:<%= track[:number] %>" class="flex items-center gap-3">
            <%= image_tag Music.cover_url(album[:id]), alt: "", class: "h-10 w-10 rounded object-cover shadow" %>

            <div class="min-w-0">
              <p class="truncate font-semibold"><%= track[:title] %></p>
              <p class="truncate text-xs text-gray-500"><%= album[:artist] %> &middot; <%= album[:title] %></p>
            </div>

            <span class="ml-auto text-xs tabular-nums text-gray-400"><%= track[:duration] %></span>
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>
</aside>

<% if alert.present? %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-emerald-600 text-white" data-herb-set="keydown.escape@window->alert=''">
    <div class="text-center">
      <p class="text-2xl"><%= alert %></p>
      <button type="button" data-herb-set="alert=''" class="mt-4 text-sm underline">Dismiss</button>
    </div>
  </div>
<% end %>
